# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string for DHANYA persistent production database.
# Keep credentials private and never commit real passwords to source control.
DATABASE_URL="postgresql://postgres:Ashvin@Binu1412@localhost:5432/dhanya"
STORAGE_ADAPTER="postgres"

# DHANYA_ENV: Environment mode ('development' | 'test' | 'production')
DHANYA_ENV="development"

# DHANYA_ENABLE_DEV_AUTH: Explicit flag to enable development personas and /auth/dev-* endpoints
# Must be 'false' by default. Strictly ignored and disabled in production.
DHANYA_ENABLE_DEV_AUTH="false"

# DHANYA_AUTH_PROVIDER: Active authentication provider ('dev' | 'oidc')
DHANYA_AUTH_PROVIDER="dev"

# DHANYA_AUTH_SECRET: High-entropy secret used for HMAC-SHA256 token signing
DHANYA_AUTH_SECRET="your-high-entropy-auth-signing-secret"

# DHANYA_ADMIN_EMAIL: Single authorized production administrator / owner email identity
DHANYA_ADMIN_EMAIL="admin@dhanya.com"
