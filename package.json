{
  "name": "dhanya",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "web",
    "admin",
    "backend",
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx scripts/generate-theme.ts && tsx server.ts",
    "tokens:sync": "tsx scripts/generate-theme.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "dev:admin": "vite --config admin/vite.config.ts",
    "dev:backend": "tsx backend/src/server.ts",
    "prebuild": "tsx scripts/generate-theme.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "build:admin": "vite build --config admin/vite.config.ts",
    "build:backend": "esbuild backend/src/server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=backend/dist/server.cjs",
    "build": "tsx scripts/generate-theme.ts && npm run build:web && npm run build:admin && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "node dist/server.cjs",
    "clean": "rm -rf dist web/dist admin/dist backend/dist",
    "test": "tsx backend/tests/security-invariants.test.ts && tsx backend/tests/admin-single-owner-hardening.test.ts && tsx backend/tests/auth-and-persistence.test.ts && tsx backend/tests/auth-integration.test.ts && tsx backend/tests/contracts-and-persistence.test.ts && tsx backend/tests/phase7b-gap-closure.test.ts && tsx backend/tests/decision-engine-and-reports.test.ts",
    "test:security": "tsx backend/tests/security-invariants.test.ts",
    "test:admin": "tsx backend/tests/admin-single-owner-hardening.test.ts",
    "test:contracts": "tsx backend/tests/contracts-and-persistence.test.ts",
    "test:auth": "tsx backend/tests/auth-integration.test.ts",
    "test:phase7b": "tsx backend/tests/phase7b-gap-closure.test.ts",
    "test:decision": "tsx backend/tests/decision-engine-and-reports.test.ts",
    "test:browser": "tsx backend/tests/playwright-browser-qa.test.ts",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
